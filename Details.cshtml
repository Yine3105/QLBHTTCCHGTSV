@model cửa_hàng_sinh_viên_guitar.Models.DONHANG

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_giaodien.cshtml";
}

<style>
    /* --- KHUNG CHỨA --- */
    .detail-container {
        padding: 40px 0;
        min-height: 80vh;
    }

    /* --- TIÊU ĐỀ --- */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #333;
        padding-bottom: 20px;
    }
    .page-header h2 {
        color: #fff;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
    }
    .page-header span {
        color: #f59e0b;
    }

    /* --- CÁC KHỐI THÔNG TIN (CARDS) --- */
    .info-card {
        background: #1a1a1a;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        border: 1px solid #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .info-card h4 {
        color: #f59e0b;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        text-transform: uppercase;
        border-bottom: 1px dashed #444;
        padding-bottom: 10px;
    }

    .info-row {
        display: flex;
        margin-bottom: 12px;
        font-size: 15px;
    }
    .info-label {
        width: 140px;
        color: #888;
        font-weight: 600;
    }
    .info-value {
        color: #ddd;
        flex: 1;
    }

    /* --- BẢNG SẢN PHẨM --- */
    .product-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    .product-table th {
        text-align: left;
        color: #888;
        padding: 10px 0;
        border-bottom: 1px solid #444;
        font-size: 14px;
        text-transform: uppercase;
    }
    .product-table td {
        padding: 15px 0;
        border-bottom: 1px solid #222;
        color: #fff;
        vertical-align: middle;
    }
    .product-name {
        font-weight: 600;
        font-size: 16px;
    }
    .product-code {
        font-size: 12px;
        color: #666;
    }

    /* --- TỔNG TIỀN --- */
    .total-section {
        display: flex;
        justify-content: flex-end;
        padding-top: 20px;
    }
    .total-box {
        text-align: right;
        min-width: 250px;
    }
    .total-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 16px;
        color: #ccc;
    }
    .final-total {
        border-top: 1px solid #444;
        padding-top: 15px;
        margin-top: 10px;
        font-size: 24px;
        font-weight: 800;
        color: #f59e0b;
    }

    /* --- TRẠNG THÁI BADGE (Tái sử dụng) --- */
    .status-badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
    }
    .status-new { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
    .status-pending { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-shipping { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-cancel { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .status-default { background: rgba(255, 255, 255, 0.1); color: #ccc; border: 1px solid #444; }

    /* --- BUTTONS --- */
    .btn-back {
        background: #333;
        color: #fff;
        padding: 10px 25px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-back:hover {
        background: #444;
        color: #f59e0b;
        text-decoration: none;
    }
</style>

<div class="container detail-container">
    
    <div class="page-header">
        <h2>Đơn hàng <span>#@Model.maDH</span></h2>
        <a href="@Url.Action("Index")" class="btn-back">
            <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="info-card">
                <h4>Thông tin chung</h4>
                <div class="info-row">
                    <span class="info-label">Ngày đặt:</span>
                    <span class="info-value">@string.Format("{0:dd/MM/yyyy HH:mm}", Model.ngayTao)</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Trạng thái:</span>
                    <span class="info-value">
                        @{
                            string sClass = "status-default";
                            string sText = Model.trangThaiDonHang;
                            if (sText == "Mới") { sClass = "status-new"; }
                            else if (sText == "Chờ thanh toán" || sText == "Chờ xử lý") { sClass = "status-pending"; }
                            else if (sText == "Hoàn thành") { sClass = "status-shipping"; }
                            else if (sText == "Đã hủy") { sClass = "status-cancel"; }
                        }
                        <span class="status-badge @sClass">@sText</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Nhân viên:</span>
                    <span class="info-value">@Model.NHANVIEN.tenNV</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Ghi chú:</span>
                    <span class="info-value" style="font-style:italic;">@(string.IsNullOrEmpty(Model.ghiChu) ? "Không có" : Model.ghiChu)</span>
                </div>
            </div>

            <div class="info-card">
                <h4>Khách hàng</h4>
                <div class="info-row">
                    <span class="info-label">Họ tên:</span>
                    <span class="info-value" style="font-weight:bold; color:#fff;">@Model.KHACHHANG.tenKH</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Số điện thoại:</span>
                    <span class="info-value">@Model.KHACHHANG.soDienThoai</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Địa chỉ:</span>
                    <span class="info-value">@Model.KHACHHANG.diaChi</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span class="info-value">@Model.KHACHHANG.email</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="info-card">
                <h4>Danh sách sản phẩm</h4>
                
                <table class="product-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Sản phẩm</th>
                            <th style="width: 15%; text-align:center;">Số lượng</th>
                            <th style="width: 20%; text-align:right;">Đơn giá</th>
                            <th style="width: 15%; text-align:right;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CHITIETDONHANGs)
                        {
                            var thanhTien = item.soLuong * item.donGiaLuuTru;
                            <tr>
                                <td>
                                    <div class="product-name">@item.SANPHAM.tenSP</div>
                                    <div class="product-code">Mã SP: @item.maSP</div>
                                </td>
                                <td style="text-align:center;">x @item.soLuong</td>
                                <td style="text-align:right;">@string.Format("{0:N0}", item.donGiaLuuTru)</td>
                                <td style="text-align:right; color:#f59e0b; font-weight:600;">
                                    @string.Format("{0:N0}", thanhTien)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="total-section">
                    <div class="total-box">
                        <div class="total-row">
                            <span>Tạm tính:</span>
                            <span>
                                @{
                                    decimal tongTien = Model.CHITIETDONHANGs.Sum(x => x.soLuong * x.donGiaLuuTru);
                                }
                                @string.Format("{0:N0} đ", tongTien)
                            </span>
                        </div>
                        <div class="total-row">
                            <span>Phí vận chuyển:</span>
                            <span>0 đ</span>
                        </div>
                        <div class="total-row final-total">
                            <span style="font-size:18px; color:#888; font-weight:600;">TỔNG CỘNG:</span>
                            <span>@string.Format("{0:N0} đ", tongTien)</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>