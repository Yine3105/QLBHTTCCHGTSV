
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_giaodien.cshtml";
}

<!-- HERO -->
<section class="hero">
    <img class="hero-bg"
         src="https://images.unsplash.com/photo-1511379938547-c1f69419868d?w=1200"
         alt="">
    <div class="hero-content">
        <h1>Về <span>GuitarStore</span></h1>
        <p>Hệ thống cửa hàng nhạc cụ uy tín hàng đầu Việt Nam với hơn 13 năm kinh nghiệm</p>
    </div>
</section>

<!-- STATS -->
<section class="stats">
    <div class="stats-grid">
        <div class="stat">
            <h3>13+</h3>
            <p>Năm kinh nghiệm</p>
        </div>
        <div class="stat">
            <h3>10,000+</h3>
            <p>Khách hàng tin tưởng</p>
        </div>
        <div class="stat">
            <h3>50+</h3>
            <p>Thương hiệu đối tác</p>
        </div>
    </div>
</section>
<!-- STORY -->
<section class="story">
    <div class="story-grid">

        <!-- TEXT -->
        <div class="story-text">
            <h2>Câu Chuyện <span>Của Chúng Tôi</span></h2>
            <p>
                Shop Guitar Sinh Viên được thành lập vào năm 2012, là một trong những cửa hàng nhạc cụ và đào tạo âm nhạc uy tín tại thành phố Nha Trang. Ngay từ những ngày đầu hoạt động, shop đã hướng đến việc phục vụ cộng đồng yêu âm nhạc, đặc biệt là học sinh, sinh viên và những người mới bắt đầu làm quen với nhạc cụ. Cửa hàng chuyên kinh doanh đa dạng các loại nhạc cụ như guitar và piano với nhiều dòng, nhiều kiểu dáng và mức giá khác nhau, đáp ứng nhu cầu từ người chơi cơ bản đến người chơi nâng cao và chuyên nghiệp.
            </p>
            <p>
                Bên cạnh việc bán nhạc cụ, Shop Guitar Sinh Viên còn cung cấp các khóa học âm nhạc và trực tiếp tổ chức dạy đàn với đội ngũ giảng viên có kinh nghiệm, phương pháp giảng dạy dễ hiểu và thực tế. Học viên không chỉ được học lý thuyết mà còn được hướng dẫn thực hành bài bản, giúp nâng cao kỹ năng và niềm đam mê âm nhạc. Với không gian học tập thân thiện, gần gũi, shop tạo điều kiện để người học cảm thấy thoải mái và tự tin khi theo đuổi âm nhạc.
            </p>
            <p>
                Hiện nay, Shop Guitar Sinh Viên tọa lạc tại 42 Lạc Thiện, phường Vĩnh Phước, Nha Trang, là điểm đến quen thuộc của nhiều khách hàng trong khu vực. Với hơn nhiều năm hoạt động, shop không chỉ là nơi mua sắm nhạc cụ mà còn là không gian giao lưu, học hỏi và chia sẻ đam mê âm nhạc. Khách hàng có thể dễ dàng liên hệ và được tư vấn qua số điện thoại 039 403 3424.
            </p>
        </div>

        <!-- IMAGE -->
        <div class="story-image">
            <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=900" alt="Music Store Story">
            <div class="story-badge">
                <strong>2012</strong>
                <span>Năm thành lập</span>
            </div>
        </div>

    </div>
</section>

<!-- VALUES -->
<section class="values">
    <h2>Giá Trị <span>Cốt Lõi</span></h2>
    <div class="values-grid">
        <div class="value-card">
            <i class="fa-solid fa-shield"></i>
            <h4>Chính hãng 100%</h4>
            <p>Cam kết sản phẩm chính hãng</p>
        </div>
        <div class="value-card">
            <i class="fa-solid fa-truck"></i>
            <h4>Giao hàng toàn quốc</h4>
            <p>Miễn phí vận chuyển đơn trên 2 triệu</p>
        </div>
        <div class="value-card">
            <i class="fa-solid fa-headset"></i>
            <h4>Hỗ trợ 24/7</h4>
            <p>Tư vấn chuyên nghiệp</p>
        </div>
        <div class="value-card">
            <i class="fa-solid fa-award"></i>
            <h4>Bảo hành chính hãng</h4>
            <p>12–24 tháng</p>
        </div>
    </div>
</section>

