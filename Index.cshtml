@using PagedList.Mvc;
@using PagedList;
@model PagedList.IPagedList<cửa_hàng_sinh_viên_guitar.Models.DONHANG>

@{
    ViewBag.Title = "Tra cứu đơn hàng";
    Layout = "~/Views/Shared/_giaodien.cshtml";
}

<style>
    /* Container chính */
    .lookup-container {
        padding: 40px 0;
        min-height: 80vh;
    }

    /* Tiêu đề trang */
    .page-title {
        text-align: center;
        margin-bottom: 40px;
    }

        .page-title h2 {
            font-size: 36px;
            font-weight: 800;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .page-title span {
            color: #f59e0b;
        }

    /* Form tìm kiếm */
    .search-wrapper {
        background: #1a1a1a;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
        display: flex;
        gap: 15px;
        border: 1px solid #333;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    .custom-input {
        flex: 1;
        background: #0f0f0f;
        border: 1px solid #333;
        color: #fff;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        transition: 0.3s;
    }

        .custom-input:focus {
            outline: none;
            border-color: #f59e0b;
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.3);
        }

    .btn-search {
        background: #f59e0b;
        color: #000;
        font-weight: 700;
        padding: 0 30px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-search:hover {
            background: #d97706;
            transform: translateY(-2px);
        }

    .btn-reset {
        background: #333;
        color: #ccc;
        font-weight: 600;
        padding: 0 20px;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: 0.3s;
    }

        .btn-reset:hover {
            background: #444;
            color: #fff;
            text-decoration: none;
        }

    /* Bảng dữ liệu */
    .table-responsive {
        background: #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #333;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        color: #ddd;
    }

        .custom-table thead {
            background: #252525;
            border-bottom: 2px solid #333;
        }

        .custom-table th {
            padding: 18px;
            text-align: left;
            font-weight: 700;
            color: #f59e0b;
            text-transform: uppercase;
            font-size: 14px;
        }

        .custom-table td {
            padding: 18px;
            border-bottom: 1px solid #333;
            vertical-align: middle;
        }

        .custom-table tr:hover {
            background-color: #2a2a2a;
        }

    /* Trạng thái đơn hàng (Badges) */
    .status-badge {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    /* Màu sắc trạng thái */
    .status-new {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .status-shipping {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-cancel {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .status-default {
        background: rgba(255, 255, 255, 0.1);
        color: #ccc;
        border: 1px solid #444;
    }

    /* Nút Chi tiết */
    .btn-detail {
        color: #ccc;
        border: 1px solid #444;
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        transition: 0.3s;
    }

        .btn-detail:hover {
            border-color: #f59e0b;
            color: #f59e0b;
            background: rgba(245, 158, 11, 0.1);
            text-decoration: none;
        }

    /* Thông báo không tìm thấy */
    .no-data {
        text-align: center;
        padding: 40px;
        color: #666;
        font-style: italic;
    }

    /* --- PHÂN TRANG HIỆN ĐẠI (MINIMALIST CIRCLE) --- */
    .pagination-container {
        margin-top: 30px;
        display: flex;
        flex-direction: column; /* Để dòng chữ "Trang..." nằm dưới */
        align-items: center;
        justify-content: center;
    }

    /* Xóa style mặc định của thẻ ul */
    .pagination {
        display: flex;
        padding-left: 0;
        list-style: none;
        gap: 8px; /* Khoảng cách giữa các nút */
        margin: 0 0 10px 0;
    }

        /* Style chung cho các nút (li > a, li > span) */
        .pagination > li > a,
        .pagination > li > span {
            position: relative;
            float: none;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px; /* Kích thước cố định để nút tròn */
            height: 40px;
            border-radius: 50%; /* Biến thành hình tròn */

            color: #888;
            background-color: transparent; /* Nền trong suốt */
            border: 1px solid #333;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            /* Hiệu ứng khi di chuột vào (Hover) */
            .pagination > li > a:hover,
            .pagination > li > span:hover {
                color: #fff;
                border-color: #f59e0b;
                background-color: rgba(245, 158, 11, 0.1);
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(245, 158, 11, 0.2);
            }

        /* Trang ĐANG CHỌN (Active) */
        .pagination > .active > a,
        .pagination > .active > span,
        .pagination > .active > a:hover,
        .pagination > .active > span:hover {
            z-index: 2;
            color: #000;
            background-color: #f59e0b; /* Nền Cam đặc */
            border-color: #f59e0b;
            cursor: default;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
            transform: scale(1.1);
        }

        /* Nút bị Vô hiệu hóa (Disabled) */
        .pagination > .disabled > span,
        .pagination > .disabled > a,
        .pagination > .disabled > a:hover {
            color: #444;
            background-color: transparent;
            border-color: #222;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }
</style>

<div class="container lookup-container">

    <div class="page-title">
        <h2>Tra cứu <span>Đơn hàng</span></h2>
    </div>

    <div class="search-wrapper">
        @using (Html.BeginForm("Index", "DONHANGs", FormMethod.Get, new { @style = "display:flex; width:100%; gap:15px;" }))
        {
            <input type="text" name="searchString" class="custom-input" placeholder="Nhập Mã đơn / Tên khách / SĐT..." value="@Request.QueryString["searchString"]" />

            <button type="submit" class="btn-search">
                <i class="glyphicon glyphicon-search"></i> Tìm kiếm
            </button>

            <a href="@Url.Action("Index","DONHANGs")" class="btn-reset" title="Tải lại danh sách">
                <i class="glyphicon glyphicon-refresh"></i> Làm mới
            </a>
        }
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày tạo</th>
                    <th>Khách hàng</th>
                    <th>Nhân viên xử lý</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="6" class="no-data">
                            Không tìm thấy đơn hàng nào phù hợp!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong style="color:#fff;">@Html.DisplayFor(modelItem => item.maDH)</strong></td>

                            <td>@string.Format("{0:dd/MM/yyyy}", item.ngayTao)</td>

                            <td>
                                <div style="font-weight:600;">@Html.DisplayFor(modelItem => item.KHACHHANG.tenKH)</div>
                                <div style="font-size:12px; color:#888;">@item.KHACHHANG.soDienThoai</div>
                            </td>

                            <td>@Html.DisplayFor(modelItem => item.NHANVIEN.tenNV)</td>

                            <td>
                                @{
                                    string statusClass = "status-default";
                                    string statusText = item.trangThaiDonHang;

                                    if (statusText == "Mới") { statusClass = "status-new"; }
                                    else if (statusText == "Chờ thanh toán") { statusClass = "status-pending"; }
                                    else if (statusText == "Chờ xử lý") { statusClass = "status-pending"; }
                                    else if (statusText == "Hoàn thành") { statusClass = "status-shipping"; }
                                    else if (statusText == "Đã hủy") { statusClass = "status-cancel"; }
                                }
                                <span class="status-badge @statusClass">@statusText</span>
                            </td>

                            <td class="text-center">
                                <a href="@Url.Action("Details", new { id = item.maDH })" class="btn-detail">
                                    Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-container">
        @Html.PagedListPager(Model, page => Url.Action("Index",
             new { page, searchString = Request.QueryString["searchString"] }),
             new PagedListRenderOptions
                  {
                 UlElementClasses = new string[] { "pagination" },
                 LiElementClasses = new string[] { "page-item" },
                 LinkToPreviousPageFormat = "❮",
                 LinkToNextPageFormat = "❯",
                 LinkToFirstPageFormat = "«",
                 LinkToLastPageFormat = "»",
                 MaximumPageNumbersToDisplay = 5,
                 DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                 DisplayLinkToLastPage = PagedListDisplayMode.Always
             })
    </div>
</div>