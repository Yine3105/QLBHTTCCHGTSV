@model Project_65133295.Models.HOADON
@{ Layout = null; }

<div class="container-fluid p-0">
    <!-- Header Info -->
    <div class="row mb-3">
        <div class="col-md-6">
            <h6 class="text-uppercase text-secondary fw-bold small">Thông tin hóa đơn</h6>
            <ul class="list-unstyled">
                <li><strong>Mã hóa đơn:</strong> @Model.maHD</li>
                <li><strong>Ngày thanh toán:</strong> @Model.ngayThanhToan.ToString("dd/MM/yyyy HH:mm")</li>
                <li><strong>Phương thức TT:</strong> @Model.phuongThucThanhToan</li>
                <li><strong>Thu ngân:</strong> @(Model.NHANVIEN != null ? Model.NHANVIEN.tenNV : "N/A")</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase text-secondary fw-bold small">Khách hàng</h6>
            <ul class="list-unstyled">
                @if (Model.DONHANG != null && Model.DONHANG.KHACHHANG != null)
                {
                    <li><strong>Tên KH:</strong> @Model.DONHANG.KHACHHANG.tenKH</li>
                    <li><strong>SĐT:</strong> @Model.DONHANG.KHACHHANG.soDienThoai</li>
                    <li><strong>Email:</strong> @Model.DONHANG.KHACHHANG.email</li>
                    <li><strong>Địa chỉ:</strong> @Model.DONHANG.KHACHHANG.diaChi</li>
                }
                else
                {
                    <li><span class="text-muted">Khách vãng lai / Không có TT</span></li>
                }
            </ul>
        </div>
    </div>

    <!-- Product List -->
    <h6 class="text-uppercase text-secondary fw-bold small mb-2">Chi tiết sản phẩm</h6>
    <div class="table-responsive border rounded">
        <table class="table table-sm table-striped mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.CHITIETHOADONs != null && Model.CHITIETHOADONs.Any())
                {
                    foreach (var item in Model.CHITIETHOADONs)
                    {
                        <tr>
                            <td>
                                @if (item.SANPHAM != null)
                                {
                                    @item.SANPHAM.tenSP <br />
                                    <small class="text-muted">@item.SANPHAM.maSP</small>
                                }
                                else
                                {
                                    <span>SP @item.maSP</span>
                                }
                            </td>
                            <td class="text-center">@item.soLuong</td>
                            <td class="text-end">@item.donGiaTaiThoiDiemThanhToan.ToString("N0")</td>
                            <td class="text-end fw-bold">@((item.thanhTien ?? 0).ToString("N0"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Không có chi tiết sản phẩm</td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                 <tr>
                    <td colspan="3" class="text-end">Tổng tiền tạm tính:</td>
                    <td class="text-end">@Model.tongTienTamTinh.ToString("N0")</td>
                </tr>
                @if(Model.soTienGiamKM != null && Model.soTienGiamKM > 0)
                {
                    <tr>
                        <td colspan="3" class="text-end text-success">Khuyến mãi:</td>
                        <td class="text-end text-success">-@Model.soTienGiamKM.Value.ToString("N0")</td>
                    </tr>
                }
                <tr class="fs-5 border-top border-dark">
                    <td colspan="3" class="text-end text-danger">TỔNG THANH TOÁN:</td>
                    <td class="text-end text-danger">@Model.tongTienPhaiTra.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="mt-3 text-muted small fst-italic">
        Trạng thái đơn hàng: 
        @if (Model.DONHANG != null) {
            <span class="badge bg-info text-dark">@Model.DONHANG.trangThaiDonHang</span>
        }
    </div>
</div>
